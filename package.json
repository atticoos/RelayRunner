{
  "name": "relayrunner-workspace",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "relayrunner": "node apps/cli/cli.ts",
    "setup:worktree": "pnpm install --frozen-lockfile",
    "typecheck": "tsc --noEmit && pnpm --filter @relayrunner/api typecheck && pnpm --filter @relayrunner/webhooks typecheck && pnpm --filter @relayrunner/web typecheck",
    "lint": "oxlint --deny-warnings apps packages tests",
    "test": "vitest run",
    "prepare": "husky",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:watch": "vitest watch",
    "deploy:webhooks": "pnpm --filter @relayrunner/webhooks run deploy",
    "deploy:api": "pnpm --filter @relayrunner/api run deploy",
    "deploy:web": "pnpm --filter @relayrunner/web run deploy",
    "deploy:landing": "pnpm --filter ./apps/landing run deploy"
  },
  "type": "module"
}
