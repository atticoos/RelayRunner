{
  "name": "runner-duty",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxlint": "^1.91.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
