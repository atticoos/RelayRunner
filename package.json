{
  "name": "relayrunner-workspace",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxlint": "^1.91.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "relayrunner": "node apps/cli/cli.ts",
    "setup:worktree": "pnpm install --frozen-lockfile",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings apps packages tests",
    "test": "vitest run",
    "prepare": "husky",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:watch": "vitest watch"
  },
  "type": "module"
}
