{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.mts",
    "apps/**/*.cts",
    "packages/**/*.ts",
    "packages/**/*.mts",
    "packages/**/*.cts",
    "tests/**/*.mts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/coverage"
  ]
}
