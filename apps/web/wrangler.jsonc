{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Gateway dashboard: a React SPA served as Worker static assets, plus a tiny
  // Worker (worker/index.ts) that forwards /api/* to the API Worker.
  "name": "relayrunner-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  // The RelayRunner Cloudflare account (separate from Atticus's personal account).
  "account_id": "b233b6d6fd9eae9e093651bfb043c119",
  "assets": {
    "binding": "ASSETS",
    // Unknown paths fall back to index.html so client-side routes deep-link.
    "not_found_handling": "single-page-application",
    // /api/* must reach the Worker, not the SPA fallback. So must the Access-gated dev views,
    // or assets would serve their HTML without the check.
    "run_worker_first": ["/api/*", "/dev", "/dev/*"],
  },
  // Same-origin API: the dashboard forwards /api/* to apps/api over this binding,
  // so auth cookies stay first-party on workers.dev and on the custom domain.
  // /api/webhooks/* goes to the webhook ingress Worker instead, so API deploys never touch it.
  "services": [
    { "binding": "API", "service": "relayrunner-api" },
    { "binding": "WEBHOOKS", "service": "relayrunner-webhooks" },
  ],
  "workers_dev": true,
  // Per-version and per-alias preview URLs (<alias>-relayrunner-app.relayrun.workers.dev). Put
  // Cloudflare Access in front of them: docs/cloudflare-access.md.
  "preview_urls": true,
  "vars": {
    // Zero Trust team domain whose Access JWTs the dev-only views accept (packages/access).
    // ACCESS_AUD stays unset here: production workers.dev has no Access app, so /dev/* is 404.
    "ACCESS_TEAM_DOMAIN": "relayrunner.cloudflareaccess.com",
  },
  // Workers Logs, traces and Issues (errors grouped per Worker). Wrangler deploys overwrite
  // dashboard settings, so these must stay on here. Source maps make Issues' stacks point at
  // the TypeScript source.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  "upload_source_maps": true,
  // Settings for PR preview builds (`wrangler preview` in Workers Builds).
  // Bindings aren't inherited here, so previews forward /api/* to the
  // production API Worker too. Sign-in works through the API's oAuthProxy plugin
  // (PREVIEW_ORIGINS in apps/api/wrangler.jsonc), against production data.
  "previews": {
    "services": [
      { "binding": "API", "service": "relayrunner-api" },
      { "binding": "WEBHOOKS", "service": "relayrunner-webhooks" },
    ],
    "observability": { "enabled": true },
    // Vars aren't inherited either. ACCESS_AUD is the Application Audience tag of the Access app
    // on this Worker's preview URLs; while it's empty, /dev/* answers 404 on previews too.
    "vars": {
      "ACCESS_TEAM_DOMAIN": "relayrunner.cloudflareaccess.com",
      "ACCESS_AUD": "",
    },
  },
  // Production routing (enable once DNS lives in the new account):
  // "routes": [{ "pattern": "app.relayrunner.dev", "custom_domain": true }]
}
