{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relayrunner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  // The RelayRunner Cloudflare account (separate from Atticus's personal account).
  "account_id": "b233b6d6fd9eae9e093651bfb043c119",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relayrunner",
      // Placeholder. Run `wrangler d1 create relayrunner` in the target account and paste the id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PICK_RUNNER", "class_name": "PickRunner" },
      { "name": "ROUTER", "class_name": "Router" },
      { "name": "MACHINE_LINK", "class_name": "MachineLink" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PickRunner", "Router", "MachineLink"] }]
}
