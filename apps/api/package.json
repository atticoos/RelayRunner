{
  "name": "@relayrunner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply relayrunner --local",
    "db:migrate:remote": "wrangler d1 migrations apply relayrunner --remote"
  },
  "dependencies": {
    "better-auth": "^1.7.16",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "@relayrunner/github-webhooks": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  }
}
