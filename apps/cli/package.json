{
  "name": "runnerduty",
  "version": "0.1.0",
  "description": "Switch selected GitHub Actions jobs between GitHub-hosted runners and your machine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atticoos/RunnerDuty.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "runnerduty": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && cp ../../skills/runnerduty/SKILL.md dist/SKILL.md",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
